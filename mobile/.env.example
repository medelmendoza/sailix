# Copy to .env.local (git-ignored). No secrets: values here end up in the app bundle.
APP_ENV=development
# New Laravel backend (Phase B). Local dev example; never a production credential.
# iOS simulator: http://localhost:8000 · Android emulator: http://10.0.2.2:8000 · devices: your machine's LAN address.
# staging/production profiles MUST use https:// (the app refuses to start otherwise).
API_BASE_URL=http://localhost:8000
API_PREFIX=/api/v1
PRIVACY_URL=https://www.btsolve.com/privacy/data-privacy-sailix.html

# The Tala package (packages/tala) instead of Sailix's own Tala screens, while the two are compared.
# TALA_PACKAGE=1 turns it on; the Tala address must be https; progress writes (quizzes, flashcards, join a course) are off unless =1.
# TALA_PACKAGE=1
# TALA_API_BASE_URL=https://tala.example.com
# TALA_PROGRESS_WRITES=0
