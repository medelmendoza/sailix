# Copy to .env.local (git-ignored). Everything VITE_* is public in the browser bundle: no secrets.
VITE_API_BASE_URL=http://localhost:8000

# Hosts that are the SHARED sign-in (no organization in the address). Any other host is expected to be an organization's own
# address (<slug>.<base domain> or a verified custom domain). Default: localhost,127.0.0.1
# VITE_TENANT_APEX_HOSTS=sailix.com,www.sailix.com

# Shared-address demos: ?tenant=<slug> on the sign-in page picks the organization (sent as X-Tenant-Slug). DEMO ONLY: needs
# SAILIX_TENANT_ALLOW_SLUG_HEADER=true on the API. Leave it out in production.
# VITE_TENANT_SLUG_SWITCH=true
