APP_NAME=Sailix
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=sailix
DB_USERNAME=sailix
DB_PASSWORD=change-me-locally

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Local development delivers mail immediately (sync). Production MUST use a real queue (database or redis) AND run `php artisan queue:work` (docs/14).
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SAILIX_WEB_ORIGINS=http://localhost:5173
SAILIX_EXPOSE_INVITATION_TOKEN=true # only honoured when APP_ENV is local or testing
# Superadmin one-time code. Set to false ONLY on a development machine; any other environment ignores this and always asks.
# SAILIX_PLATFORM_REQUIRE_OTP=false

# Tala gateway (platform-controlled, HTTPS only). Comma-separated EXACT host names the backend may ever contact.
# Empty = no Tala endpoint is accepted. Production use is blocked until Tala HTTPS is verified (docs/13 D-T2).
# Exact host names the Tala gateway may contact (https only). The platform setting tala_api_base_url must be one of them.
SAILIX_TALA_ALLOWED_HOSTS=

# Web page that completes a password reset (target of the emailed link). Default: first SAILIX_WEB_ORIGINS + /reset-password
# SAILIX_RESET_URL=

# Comma-separated addresses/CIDRs of the TLS-terminating load balancer (so HTTPS, HSTS and client IPs are detected). Empty = trust no proxy.
# How organizations are addressed. <slug>.<SAILIX_BASE_DOMAIN> is every organization's default address; a customer's own domain
# works once they prove it with a DNS TXT record. See docs/17-MULTI-TENANT-ADDRESSING.md.
SAILIX_BASE_DOMAIN=localhost
# Development only (ignored outside local/testing): <slug>.localhost addresses an organization.
# SAILIX_TENANT_DEV_MODE=true
# When the web portal and the API are on different hosts the portal says which host it is on (X-Tenant-Host).
# Set true only when the web portal and the API are on different hosts (the portal then names its organization in X-Tenant-Host).
# SAILIX_TENANT_ALLOW_HOST_HEADER=true
# DEMO ONLY: lets ?tenant=<slug> on the sign-in page choose the organization on one shared address.
# SAILIX_TENANT_ALLOW_SLUG_HEADER=false
SAILIX_TRUSTED_PROXIES=

# Lets the gateway WRITE learner progress to Tala. Keep false until docs/13 section 20 is resolved.
SAILIX_TALA_PROGRESS_WRITES=false
